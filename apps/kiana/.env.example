# Optional override for the public Mediaforge release in Cloudflare R2.
VITE_KIANA_MEDIA_BASE_URL=https://media.kiana.me/releases/current

# Signing in with Google, which stays off while these are empty. The
# Worker's own values are set with `wrangler secret put`; see README.md.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
