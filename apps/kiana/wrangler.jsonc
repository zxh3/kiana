{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiana",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // The click-wheel player's live apps, each one Durable Object that every
  // visitor shares: Chat, with its messages, and the
  // electronic wooden fish, with everyone's merit.
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "WOODEN_FISH", "class_name": "WoodenFish" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["WoodenFish"] }
  ],
  // Signing in with Google (Better Auth, `src/server/auth.ts`): the people
  // who have signed in and their sessions. It has no id because Cloudflare
  // creates it on the first deploy that has it, and finds it by the Worker
  // from then on.
  "d1_databases": [{ "binding": "AUTH_DB", "database_name": "kiana-auth" }],
  // Set on the Worker with `wrangler secret put`, and locally in `.env`.
  // A deploy fails until all three are set.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  }
}
